{
  "name": "ecommerce-store-backend",
  "version": "1.0.0",
  "description": "Node.js + PostgreSQL E-commerce Store Backend with Heroku & Vercel deployment support",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node -e \"require('./src/db/initDb').initDb()\"",
    "db:seed": "node -e \"require('./src/db/initDb').seedDb()\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["ecommerce", "express", "postgresql", "heroku", "cod", "bkash"],
  "author": "",
  "license": "MIT"
}

