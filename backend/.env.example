# Server Port (Heroku provides this automatically via $PORT)
PORT=5000

# PostgreSQL Connection String (Heroku Postgres automatically provides DATABASE_URL)
# Example: postgres://username:password@localhost:5432/store_db
DATABASE_URL=

# Frontend Origin for CORS (e.g., your Vercel deployment URL or localhost)
ALLOWED_ORIGIN=*

# ==============================================================================
# SECURE ADMIN ACCOUNTS (Environmental Variations Only)
# ==============================================================================
# Admins can ONLY be created or managed via this environment variable.
# Format: JSON array of admin objects with email, password, and name.
# Alternatively, colon-separated format: email:password:name,email2:password:name2
ADMIN_USERS='[{"email":"admin@example.com","password":"ChangeThisPasswordNow!","name":"Master Admin"},{"email":"manager@example.com","password":"RandomSecurePassword987!","name":"Store Manager"}]'

# Secret key used to sign Admin session JWT tokens
JWT_SECRET=replace_with_a_random_64_character_hex_string

# ==============================================================================
# bKash API Credentials (For future activation)
# ==============================================================================
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
